{
  "resources": [
    {
      "@type": "type.googleapis.com/envoy.config.cluster.v3.Cluster",
      "name": "db_pg_p5432",
      "type": "STATIC",
      "connect_timeout": "1s",
      "load_assignment": {
        "cluster_name": "db_pg_p5432",
        "endpoints": [
          {
            "lb_endpoints": [
              {
                "endpoint": {
                  "address": {
                    "socket_address": {
                      "address": "127.0.0.1",
                      "port_value": 41001
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      "health_checks": [
        {
          "timeout": "1s",
          "interval": "0.500s",
          "unhealthy_threshold": 3,
          "healthy_threshold": 1,
          "tcp_health_check": {},
          "no_traffic_interval": "0.500s",
          "unhealthy_interval": "0.500s"
        }
      ]
    },
    {
      "@type": "type.googleapis.com/envoy.config.cluster.v3.Cluster",
      "name": "web-p8080",
      "cluster_type": {
        "name": "envoy.cluster.dns",
        "typed_config": {
          "@type": "type.googleapis.com/envoy.extensions.clusters.dns.v3.DnsCluster",
          "dns_refresh_rate": "1s",
          "dns_lookup_family": "V4_ONLY"
        }
      },
      "connect_timeout": "1s",
      "load_assignment": {
        "cluster_name": "web-p8080",
        "endpoints": [
          {
            "lb_endpoints": [
              {
                "endpoint": {
                  "address": {
                    "socket_address": {
                      "address": "karga-web-r2",
                      "port_value": 8080
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      "health_checks": [
        {
          "timeout": "1s",
          "interval": "0.500s",
          "unhealthy_threshold": 3,
          "healthy_threshold": 1,
          "http_health_check": {
            "path": "/healthz",
            "expected_statuses": [
              {
                "start": "200",
                "end": "400"
              }
            ]
          },
          "no_traffic_interval": "0.500s",
          "unhealthy_interval": "0.500s"
        }
      ]
    }
  ]
}