# karga-server: owns karga's state and talks to Docker; the karga CLI connects to its socket.
# Members of the karga group may use the CLI. Install with KARGA_SYSTEMD=1 (see install.sh).
[Unit]
Description=karga server (releases, desired state and reconciliation)
Documentation=https://github.com/hasankaradmir/karga-server
After=docker.service
Requires=docker.service

[Service]
User=karga
Group=karga
SupplementaryGroups=docker
ExecStart=/usr/local/bin/karga-server --home /var/lib/karga --socket /run/karga/karga.sock
StateDirectory=karga
StateDirectoryMode=0700
RuntimeDirectory=karga
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=2s
# karga-server lets running operations finish for --shutdown-grace (5 minutes) when it stops:
# keep this above it.
TimeoutStopSec=330
LimitNOFILE=65536
# Only CAP_NET_BIND_SERVICE: before the gateway takes a listener's port, karga-server binds it for a
# moment to see that it is free, also below 1024. Docker does the privileged work through its socket.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
